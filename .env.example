# ===========================================
# Environment Configuration Template
# ===========================================
# Copy this file to .env and fill in values

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=production

# IMPORTANT: Generate secure secret keys for production!
# Run this in Python: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# Database Configuration
# SQLite (default - auto-resolved to automotive_marketplace_v2.db in project root)
# Leave commented out to use the default; the database is auto-seeded on first run.
# DATABASE_URL=sqlite:///automotive_marketplace_v2.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://username:password@localhost:5432/automotive_marketplace

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Email Configuration (for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Security Settings
WTF_CSRF_ENABLED=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true

# CORS Configuration
# Comma-separated list of allowed origins for production
# Leave empty or set to * for development
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Rate Limiting
# Using Flask-Limiter - configured in app code
# Default: 200/day, 50/hour globally
# API endpoints have specific limits (30/min for ML endpoints)

# Cache Configuration (for production)
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300
